{
  "name": "breachline",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based multiplayer 3D tactical attack/defend shooter",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build && node tools/precompress.mjs",
    "start": "node server/index.js",
    "check:maps": "node tools/check-map.mjs",
    "worker:dev": "npx --yes wrangler@4.153.0 dev",
    "worker:deploy": "npx --yes wrangler@4.153.0 deploy",
    "neon:local": "node tools/neon-local.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  }
}
